{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "NotesSync",
  "identifier": "com.webdesserts.notes-sync",
  "build": {
    "beforeBuildCommand": "npm ci && npm run build",
    "frontendDist": "frontend/dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": []
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": ["app", "dmg"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "14.0"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEMwQ0Y3OTYzQUUyOUU5RTkKUldUcDZTbXVZM25Qd0JVOURVV3ZkQlI2cWV6emNOdWozVGZwZUZ5ZlJZYVhzaTRacEQwZjNiTWYK",
      "endpoints": [
        "https://github.com/webdesserts/notes/releases/latest/download/latest.json"
      ]
    }
  }
}
